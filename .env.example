# Same MongoDB the admin (pradeep.miriyala.in repo) writes to. Database name is fixed in src/lib/mongodb.ts.
MONGODB_URI=

# Must be IDENTICAL to the admin site's NEXTAUTH_SECRET. It signs the captcha and the career-expert cookies, and
# the codes stored by the admin's Careers tab are hashed with it. The admin's cache-refresh call is signed with it too.
NEXTAUTH_SECRET=

# Optional: spam limits for the suggestion and feedback forms
# COMMENT_RATE_LIMIT_MAX=
# COMMENT_RATE_LIMIT_WINDOW_MS=
